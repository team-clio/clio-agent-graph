{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow-gate.py\"",
            "timeout": 10,
            "statusMessage": "workflow-rule 적용 여부 확인"
          }
        ]
      }
    ]
  }
}
