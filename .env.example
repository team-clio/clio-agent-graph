# Local Agent Server
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=clio-agent-graph

# One global chat model for every LLM node and Agent. LangChain interprets the
# provider:model identifier and reads the provider's standard credential variable.
CLIO_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# Optional settings for an OpenAI-compatible or self-hosted endpoint.
# CLIO_MODEL_BASE_URL=https://api.deepseek.com
# CLIO_MODEL_API_KEY_ENV=DEEPSEEK_API_KEY
# CLIO_MODEL_EXTRA_BODY={"thinking":{"type":"disabled"}}

# Codex CLI remains an optional read-only code exploration tool, not a second chat model.
CLIO_CODEX_TIMEOUT_SECONDS=300
CLIO_CODE_EXPLORER=disabled
CLIO_CODEBASE_PATH=

CLIO_MAX_RAW_PAYLOAD_BYTES=32768
CLIO_RM_AUTO_LINK_THRESHOLD=0.95
CLIO_RM_REVIEW_THRESHOLD=0.70
CLIO_RM_CANDIDATE_MARGIN=0.10

# Persistent Project Context Memory. When CLIO_PCM_DATABASE_URL is unset,
# the server uses the development-only in-memory PCM.
# CLIO_PCM_DATABASE_URL=postgresql://clio:clio_dev_password@127.0.0.1:55432/clio_pcm
# CLIO_PCM_DATA_ROOT=.clio/pcm-data

# Issue Retrieval Agent가 같은 PostgreSQL과 의미 embedding 모델을 사용합니다.
CLIO_DATABASE_URL=postgresql+psycopg://clio:clio@localhost:5432/clio
CLIO_EMBEDDING_MODEL=ollama:qwen3-embedding:0.6b
CLIO_OLLAMA_BASE_URL=http://127.0.0.1:11434
CLIO_OLLAMA_TIMEOUT_SECONDS=120
