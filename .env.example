# Local Agent Server
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=clio-agent-graph

# LLM Agent configuration. DeepSeek is the default OpenAI-compatible provider.
# Use CLIO_LLM_PROVIDER=openai_compatible with the remaining three variables
# to switch to another OpenAI-compatible endpoint without changing code.
CLIO_LLM_PROVIDER=deepseek
CLIO_LLM_MODEL=deepseek-chat
CLIO_LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# CLIO_LLM_API_KEY_ENV=DEEPSEEK_API_KEY

# Persistent Project Context Memory. When CLIO_PCM_DATABASE_URL is unset,
# the server uses the development-only in-memory PCM.
# CLIO_PCM_DATABASE_URL=postgresql://clio:clio_dev_password@127.0.0.1:55432/clio_pcm
# CLIO_PCM_DATA_ROOT=.clio/pcm-data
