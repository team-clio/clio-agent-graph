# Local Agent Server
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=clio-agent-graph

# 기본값은 provider API입니다. ChatGPT 구독 인증을 쓰려면 codex로 변경하세요.
CLIO_MODEL=openai:gpt-4.1-mini
CLIO_CHAT_BACKEND=langchain
CLIO_CODEX_TIMEOUT_SECONDS=300
CLIO_CODE_EXPLORER=disabled
CLIO_CODEBASE_PATH=
CLIO_MAX_RAW_PAYLOAD_BYTES=32768
CLIO_RM_AUTO_LINK_THRESHOLD=0.95
CLIO_RM_REVIEW_THRESHOLD=0.70
CLIO_RM_CANDIDATE_MARGIN=0.10
# Issue Retrieval Agent가 같은 PostgreSQL과 의미 embedding 모델을 사용합니다.
CLIO_DATABASE_URL=postgresql+psycopg://clio:clio@localhost:5432/clio
CLIO_EMBEDDING_MODEL=ollama:qwen3-embedding:0.6b
CLIO_OLLAMA_BASE_URL=http://127.0.0.1:11434
CLIO_OLLAMA_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
