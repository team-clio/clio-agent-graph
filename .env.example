# Local Agent Server
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=clio-agent-graph

# Model configuration used when an LLM-backed node is added.
CLIO_MODEL=openai:gpt-4.1-mini
CLIO_MAX_RAW_PAYLOAD_BYTES=32768
CLIO_RM_AUTO_LINK_THRESHOLD=0.95
CLIO_RM_REVIEW_THRESHOLD=0.70
CLIO_RM_CANDIDATE_MARGIN=0.10
# Issue Retrieval Agent가 같은 PostgreSQL과 의미 embedding 모델을 사용합니다.
CLIO_DATABASE_URL=postgresql+psycopg://clio:clio@localhost:5432/clio
CLIO_EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=
